    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Original row data, matched to this item by n8n's item pairing\nconst src = $('Extract Domain').item.json;\nconst page = $json;\n\nconst clean = (v) => String(v ?? '').replace(/\\s+/g, ' ').trim();\n\n// Company name: prefer og:site_name, else the first part of <title>\n// (split only on separators with spaces, so \"Coca-Cola\" stays whole)\nlet companyName = clean(page.og_site_name);\nif (!companyName && page.page_title) {\n  companyName = clean(String(page.page_title).split(/\\s[|\\-–—:]\\s/)[0]);\n}\n\nconst description = clean(page.meta_description || page.og_description).slice(0, 300);\nconst found = Boolean(companyName || description);\n\nreturn {\n  json: {\n    Email: src.Email,\n    Domain: src.Domain,\n    'Company Name': companyName,\n    Website: src.website_url,\n    Description: description,\n    LinkedIn: clean(page.linkedin_url),\n    Logo: `https://www.google.com/s2/favicons?domain=${src.Domain}&sz=128`,\n    Status: found ? 'Enriched' : 'Website not reachable',\n    'Last Checked': new Date().toISOString(),\n  },\n};"
      },
