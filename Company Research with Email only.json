    {
      "parameters": {
        "jsCode": "// Personal email providers: there is no company to research\nconst FREE_PROVIDERS = new Set([\n  'gmail.com', 'googlemail.com', 'yahoo.com', 'yahoo.co.uk', 'ymail.com',\n  'hotmail.com', 'outlook.com', 'live.com', 'msn.com', 'icloud.com', 'me.com',\n  'aol.com', 'proton.me', 'protonmail.com', 'zoho.com', 'gmx.com', 'mail.com', 'yandex.com'\n]);\n\n// Read a column no matter its capitals or extra spaces\n// ('email ', 'Email', ' EMAIL' all work)\nconst getField = (row, name) => {\n  const key = Object.keys(row).find(k => k.trim().toLowerCase() === name);\n  return key ? String(row[key] ?? '').trim() : '';\n};\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  // Skip rows a previous run already handled\n  if (getField(item.json, 'status')) continue;\n\n  const name = getField(item.json, 'name');\n  const email = getField(item.json, 'email');   // keep original for matching later\n  const lower = email.toLowerCase();\n\n  const isValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(lower);\n  const [username, domain] = isValid ? lower.split('@') : ['', ''];\n  const isPersonal = FREE_PROVIDERS.has(domain);\n\n  results.push({\n    json: {\n      Name: name,\n      Email: email,\n      username,\n      Domain: domain,\n      website_url: domain ? `https://${domain}` : '',\n      should_research: isValid && !isPersonal,\n      skip_reason: !isValid ? 'Invalid email'\n                 : isPersonal ? 'Personal email (no company)'\n                 : '',\n    },\n  });\n}\n\nreturn results;"
      },
